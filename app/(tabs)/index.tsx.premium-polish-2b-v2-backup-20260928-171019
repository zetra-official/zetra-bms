                  {formatValue(item.value)}
                </Text>
              </View>
            </View>
          );
        })}
      </View>

      <View
        style={{
          borderRadius: 18,
          borderWidth: 1,
       borderColor:
  netAfterExpenses < 0
    ? "rgba(239,68,68,0.42)"
    : "rgba(16,185,129,0.34)",

backgroundColor:
  netAfterExpenses < 0
    ? "rgba(239,68,68,0.18)"
    : "rgba(16,185,129,0.14)",
