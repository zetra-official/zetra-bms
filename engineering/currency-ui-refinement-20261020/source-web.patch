+
+import Svg, {
+  Circle,
+  Line,
+  Path,
+  Rect,
+  Text as SvgText,
+} from "react-native-svg";
+
+import type {
+  FinancialBucketResult,
+  FinancialMetric,
+} from "./financialDataEngine";
+
+export type FinancialChartMode =
+  | "DONUT"
+  | "TREND"
+  | "BARS";
+
+export type FinancialTrendMetric =
+  | "SALES"
+  | "EXPENSES"
+  | "NET_PROFIT";
+
+type Props = {
+  mode: FinancialChartMode;
+  metric?: FinancialTrendMetric;
+  total: FinancialMetric;
+  buckets: FinancialBucketResult[];
+
+  /*
+   * Optional comparison series.
+   *
+   * Compact Home chart does not provide this,
+   * therefore its current behavior remains unchanged.
+   *
+   * Premium Full View may provide the verified
+   * previous-period buckets.
+   */
+  previousBuckets?: FinancialBucketResult[];
+
+  /*
+   * Compact Home rendering.
+   * Keeps premium mini-chart treatment isolated from Full View.
+   */
+  compact?: boolean;
+
+  width?: number;
+  height?: number;
+};
+
+const SALES_COLOR =
+  "#2563EB";
+
+const EXPENSE_COLOR =
+  "#F59E0B";
+
+const PROFIT_COLOR =
+  "#16A34A";
+
+const LOSS_COLOR =
+  "#DC2626";
+
+const GRID_COLOR =
+  "#E2E8F0";
+
+const TEXT_COLOR =
+  "#334155";
+
+function finite(
+  value: unknown
+) {
+  const parsed =
+    Number(value ?? 0);
+
+  return Number.isFinite(parsed)
+    ? parsed
+    : 0;
+}
+
+function moneyCompact(
+  value: number
+) {
+  const amount =
+    Math.abs(finite(value));
+
+  if (amount >= 1_000_000_000) {
+    return `${(
+      amount /
+      1_000_000_000
+    ).toFixed(1)}B`;
+  }
+
+  if (amount >= 1_000_000) {
+    return `${(
+      amount /
+      1_000_000
+    ).toFixed(1)}M`;
+  }
+
+  if (amount >= 1_000) {
+    return `${(
+      amount /
+      1_000
+    ).toFixed(1)}K`;
+  }
+
+  return Math.round(
+    amount
+  ).toLocaleString("en-US");
+}
+
+function moneyFull(
+  value: number
+) {
+  try {
+    return `TSh ${Math.round(
+      finite(value)
+    ).toLocaleString("en-US")}`;
+  } catch {
+    return `TSh ${Math.round(
+      finite(value)
+    )}`;
+  }
+}
+
+function polarPoint(
+  cx: number,
+  cy: number,
+  radius: number,
+  angle: number
+) {
+  const radians =
+    ((angle - 90) *
+      Math.PI) /
+    180;
+
+  return {
+    x:
+      cx +
+      radius *
+        Math.cos(radians),
+    y:
+      cy +
+      radius *
+        Math.sin(radians),
+  };
