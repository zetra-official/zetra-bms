                            backgroundColor:
                              selected
                                ? option.activeBackground
                                : "transparent",
                          }}
                        >
                          <View
                            style={{
                              width: 8,
                              height: 8,
                              borderRadius: 999,
                              backgroundColor:
                                option.color,
