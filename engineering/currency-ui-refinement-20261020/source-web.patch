+                    item.color
+                  }
+                  strokeWidth={
+                    strokeWidth
+                  }
+                  strokeLinecap="round"
+                />
+              );
+            }
+          )}
+
+        <SvgText
+          x={cx}
+          y={cy - 7}
+          textAnchor="middle"
+          fontSize="9"
+          fontWeight="800"
+          fill="#64748B"
+        >
+          {uiText("BUSINESS")}</SvgText>
+
+        <SvgText
+          x={cx}
+          y={cy + 10}
+          textAnchor="middle"
+          fontSize="13"
+          fontWeight="900"
+          fill="#0F172A"
+        >
+          {uiText("OVERVIEW")}</SvgText>
+      </Svg>
+    </View>
+  );
+}
+
+function TrendChart({
+  buckets,
+  previousBuckets = [],
+  width,
+  height,
+  metric = "SALES",
+  compact = false,
+}: {
+  buckets: FinancialBucketResult[];
+  previousBuckets?: FinancialBucketResult[];
+  width: number;
+  height: number;
+  metric?: FinancialTrendMetric;
+  compact?: boolean;
+}) {
+ const preferredMoney=usePreferredDisplayMoney();const moneyCompact=(value:number)=>{const label=preferredMoney(value);return label.startsWith('Conversion unavailable')?'—':label.replace(/\s+[A-Z]{3}$/,'').replace(/^[A-Z]{3}\s*/,'')};
+
+ const uiText = useCommonText();
+  /*
+   * Professional finance chart layout.
+   *
+   * Left space is deliberately larger so financial
+   * values never collide with the plot.
+   *
+   * Bottom space is reserved for the time axis.
+   */
+  const [hoveredIndex, setHoveredIndex] =
+    React.useState<number | null>(null);
+
+  const [
+    hoveredPreviousIndex,
+    setHoveredPreviousIndex,
