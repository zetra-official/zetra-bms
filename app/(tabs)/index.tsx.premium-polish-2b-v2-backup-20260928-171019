  const expenseBreakdownTotal =
    toNum(expenseByChannel.cash) +
    toNum(expenseByChannel.bank) +
    toNum(expenseByChannel.mobile);

  const effectiveExpenseTotal =
    isStaffView && canStaffSeeExpenseFinance
