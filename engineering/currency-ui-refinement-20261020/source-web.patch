+import {usePreferredDisplayMoney} from '@/src/currency/PreferredDisplay';
+import {useCommonText} from "@/src/i18n/useCommonText";
+﻿import React, {
+  useMemo,
+} from "react";
+
+import {
+  Platform,
+  Text,
+  View,
+} from "react-native";
+
+// RN SVG accepts DOM hover handlers on Web; native retains its existing onPress.
