-
-  const scaleRange = Math.max(
-    1,
-    scaleMax - scaleMin
-  );
-
-  const xAt = (
-    index: number
-  ) => {
-    if (buckets.length <= 1) {
-      return left + plotWidth / 2;
-    }
-
-    return (
-      left +
-      (index /
-        (buckets.length - 1)) *
-        plotWidth
-    );
-  };
-
-  const yAt = (
-    value: number
-  ) =>
-    top +
-    ((scaleMax - finite(value)) /
-      scaleRange) *
-      plotHeight;
-
-  const makePath = () =>
-    buckets
-      .map((bucket, index) => {
-        const x = xAt(index);
-        const y = yAt(
-          bucket[metricKey]
-        );
-
-        return `${
-          index === 0 ? "M" : "L"
-        } ${x} ${y}`;
-      })
-      .join(" ");
-
-  const makePreviousPath = () =>
-    previousBuckets
-      .map((bucket, index) => {
-        /*
-         * Previous buckets are aligned by position
-         * with the current comparison buckets.
-         */
-        const denominator =
-          Math.max(
-            1,
-            previousBuckets.length - 1
-          );
-
-        const x =
-          previousBuckets.length <= 1
-            ? left + plotWidth / 2
-            : left +
-              (index / denominator) *
-                plotWidth;
-
-        const y = yAt(
-          bucket[metricKey]
-        );
-
-        return `${
-          index === 0 ? "M" : "L"
-        } ${x} ${y}`;
-      })
-      .join(" ");
-
-  const zeroY = yAt(0);
-
-  /*
-   * Comparison band:
-   * fills ONLY the space between Current and Previous.
-   *
-   * We intentionally align both series across the same
-   * horizontal comparison space, then walk Current forward
-   * and Previous backward to create one closed polygon.
