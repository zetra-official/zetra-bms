+  return [
+    "M",
+    start.x,
+    start.y,
+    "A",
+    radius,
+    radius,
+    0,
+    largeArc,
+    0,
+    end.x,
+    end.y,
+  ].join(" ");
+}
+
+function DonutChart({
+  total,
+  width,
+  height,
+}: {
+  total: FinancialMetric;
+  width: number;
+  height: number;
+}) {
+ const uiText = useCommonText();
+  /*
+   * Donut is a financial composition view.
+   *
+   * We deliberately use absolute magnitudes
+   * for visual proportions. Negative profit
+   * is rendered as Loss using red.
+   */
+  const profit =
+    finite(
+      total.netProfit
+    );
+
+  const values = [
+    {
+      key: "sales",
+      label: "Sales",
+      value: Math.max(
+        0,
+        finite(total.sales)
+      ),
+      color: SALES_COLOR,
+    },
+    {
+      key: "expenses",
+      label: "Expenses",
+      value: Math.max(
+        0,
+        finite(
+          total.expenses
+        )
+      ),
+      color: EXPENSE_COLOR,
+    },
+    {
+      key: "profit",
+      label:
+        profit < 0
+          ? "Loss"
+          : "Net Profit",
+      value: Math.abs(
+        profit
+      ),
+      color:
+        profit < 0
+          ? LOSS_COLOR
+          : PROFIT_COLOR,
+    },
+  ];
+
+  const sum =
+    values.reduce(
+      (acc, item) =>
+        acc +
+        item.value,
+      0
+    );
+
+  const cx =
+    width / 2;
+
+  const cy =
+    height / 2;
+
+  const radius =
+    Math.min(
+      width,
+      height
+    ) * 0.36;
+
+  const strokeWidth =
+    Math.max(
+      18,
+      radius * 0.24
+    );
+
+  let angle = 0;
+
+  return (
+    <View
+      style={{
+        width,
+        height,
+        alignItems:
+          "center",
+        justifyContent:
+          "center",
+      }}
+    >
+      <Svg
+        width={width}
+        height={height}
+      >
+        <Circle
+          cx={cx}
+          cy={cy}
+          r={radius}
+          fill="none"
+          stroke="#EEF2F7"
+          strokeWidth={
+            strokeWidth
+          }
+        />
+
+        {sum > 0 &&
+          values.map(
+            (item) => {
+              if (
+                item.value <= 0
