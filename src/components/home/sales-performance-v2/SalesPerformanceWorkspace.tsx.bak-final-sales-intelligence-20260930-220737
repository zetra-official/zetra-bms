            style={({ pressed }) => ({
              minWidth: 92,
              paddingHorizontal: 12,
              paddingVertical: 8,
              borderRadius: 9,
              borderWidth: 1,
              borderColor: compare
                ? BLUE
                : "#E2E8F0",
              backgroundColor: compare
