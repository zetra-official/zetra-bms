-
-          <SvgText
-            x={left + 24}
-            y="13"
-            fontSize="9.5"
-            fontWeight="900"
-            fill="#475569"
-            pointerEvents="none"
-          >
-            {uiText("Current")}</SvgText>
-
-          <Line
-            x1={left + 78}
-            x2={left + 96}
-            y1="10"
-            y2="10"
-            stroke="#8B5CF6"
-            strokeWidth="2"
-            strokeDasharray="6 5"
-            strokeLinecap="round"
-            pointerEvents="none"
-          />
-
-          <SvgText
