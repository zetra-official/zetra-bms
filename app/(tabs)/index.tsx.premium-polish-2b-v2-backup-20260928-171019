  );

  useFocusEffect(
    useCallback(() => {
      if (isDesktopWeb) return;
      if (!orgId || !storeId) return;

      void load();
    }, [isDesktopWeb, orgId, storeId, load])
  );
  useAutoRefresh(() => {
    if (!orgId || !storeId) return;
    void load({ silent: true });
  }, !!orgId && !!storeId, AUTO_REFRESH_MS);

  const fmtHomeMoney = useCallback(
    (n: number) =>
