+
+          return `${
+            index === 0 ? "M" : "L"
+          } ${x} ${y}`;
+        }
+      );
+
+    const previousPoints =
+      Array.from(
+        { length: pointCount },
+        (_, reverseIndex) => {
+          const index =
+            pointCount -
+            1 -
+            reverseIndex;
+
+          const x = xForPoint(index);
+          const y = yAt(
+            previousBuckets[index][
+              metricKey
+            ]
+          );
+
+          return `L ${x} ${y}`;
+        }
+      );
+
+    return [
+      ...currentPoints,
+      ...previousPoints,
+      "Z",
+    ].join(" ");
+  };
+
+  /*
+   * Five readable Y-axis levels.
+   */
+  const gridRatios = [
+    0,
+    0.25,
+    0.5,
+    0.75,
+    1,
+  ];
+
+  /*
+   * For 12-month view every month remains visible.
+   * Short labels keep the axis compact.
+   */
+  const shouldShowXLabel = (
+    index: number
+  ) => {
+    if (buckets.length <= 12) {
+      return true;
+    }
+
+    const step = Math.ceil(
+      buckets.length / 8
+    );
+
+    return (
+      index % step === 0 ||
+      index === buckets.length - 1
+    );
+  };
+
+  return (
+    <Svg
+      width={width}
+      height={height}
+    >
+      {compact && previousBuckets.length > 0 && (
+        <>
+          {/* Compact comparison legend */}
+          <Line
+            x1={left}
+            x2={left + 18}
+            y1="10"
+            y2="10"
+            stroke={metricColor}
+            strokeWidth="3"
+            strokeLinecap="round"
+            pointerEvents="none"
+          />
+
+          <SvgText
+            x={left + 24}
+            y="13"
+            fontSize="9.5"
+            fontWeight="900"
+            fill="#475569"
+            pointerEvents="none"
+          >
+            {uiText("Current")}</SvgText>
+
+          <Line
+            x1={left + 78}
+            x2={left + 96}
+            y1="10"
+            y2="10"
+            stroke="#8B5CF6"
+            strokeWidth="2"
+            strokeDasharray="6 5"
+            strokeLinecap="round"
+            pointerEvents="none"
+          />
+
+          <SvgText
+            x={left + 102}
+            y="13"
+            fontSize="9.5"
+            fontWeight="900"
+            fill="#7C3AED"
+            pointerEvents="none"
+          >
+            {uiText("Previous")}</SvgText>
+        </>
+      )}
+
+      {/* Y GRID + Y VALUES */}
+      {gridRatios.map(
+        (ratio) => {
+          const y =
+            top +
+            plotHeight * ratio;
+
+          const value =
+            scaleMax -
+            scaleRange * ratio;
+
+          return (
+            <React.Fragment
+              key={`grid-${ratio}`}
+            >
+              <Line
+                x1={left}
+                x2={width - right}
+                y1={y}
+                y2={y}
+                stroke={
+                  compact
+                    ? "#DCE6F3"
+                    : GRID_COLOR
+                }
+                strokeWidth={
+                  compact ? "0.75" : "1"
+                }
+              />
+
+              <SvgText
+                x={left - 8}
+                y={y + 3}
+                textAnchor="end"
+                fontSize={compact ? "10" : "11"}
+                fontWeight={compact ? "700" : "800"}
+                fill={compact ? "#64748B" : TEXT_COLOR}
+              >
+                {value < 0
+                  ? `-${moneyCompact(
+                      Math.abs(value)
+                    )}`
+                  : moneyCompact(value)}
+              </SvgText>
+            </React.Fragment>
+          );
+        }
+      )}
+
+      {/* LEFT Y AXIS */}
+      <Line
+        x1={left}
+        x2={left}
+        y1={top}
+        y2={top + plotHeight}
+        stroke="#CBD5E1"
+        strokeWidth="1"
+      />
+
+      {/* BOTTOM X AXIS */}
+      <Line
+        x1={left}
+        x2={width - right}
+        y1={top + plotHeight}
+        y2={top + plotHeight}
+        stroke="#CBD5E1"
+        strokeWidth="1"
+      />
+
+      {/* STRONG ZERO LINE FOR PROFIT/LOSS */}
+      {scaleMin < 0 && (
+        <Line
+          x1={left}
+          x2={width - right}
+          y1={zeroY}
+          y2={zeroY}
+          stroke="#94A3B8"
+          strokeWidth="1.25"
+        />
+      )}
+
+      {buckets.length > 0 && (
+        <>
+          {/* CURRENT ↔ PREVIOUS COMPARISON BAND */}
+          {previousBuckets.length > 0 && (
+            <Path
+              d={makeComparisonAreaPath()}
+              fill={metricColor}
+              opacity={
+                compact ? "0.13" : "0.105"
+              }
+              stroke="none"
+              pointerEvents="none"
+            />
+          )}
+
+          {/* PREVIOUS PERIOD COMPARISON */}
+          {previousBuckets.length > 0 && (
+            <Path
+              d={makePreviousPath()}
+              fill="none"
+              stroke={
+                compact
+                  ? "#8B5CF6"
+                  : "#7C3AED"
+              }
+              strokeWidth={
+                compact ? "2.25" : "2.4"
+              }
+              strokeDasharray={
+                compact ? "7 5" : "8 6"
+              }
+              strokeLinecap="round"
+              strokeLinejoin="round"
+              opacity={
+                compact ? "0.58" : "0.52"
+              }
+              pointerEvents="none"
+            />
+          )}
+
+          {/* INTERACTIVE PREVIOUS PERIOD POINTS */}
+          {previousBuckets.map(
+            (bucket, index) => {
+              const denominator =
+                Math.max(
+                  1,
+                  previousBuckets.length - 1
+                );
+
+              const x =
+                previousBuckets.length <= 1
+                  ? left + plotWidth / 2
+                  : left +
+                    (index / denominator) *
+                      plotWidth;
+
+              const value =
+                finite(
+                  bucket[metricKey]
+                );
+
+              const y =
+                yAt(value);
+
+              const pointColor =
+                metric === "NET_PROFIT" &&
+                value < 0
+                  ? LOSS_COLOR
+                  : metricColor;
+
+              const active =
+                hoveredPreviousIndex ===
+                index;
+
+              return (
+                <React.Fragment
+                  key={`previous-${bucket.key}-${index}`}
+                >
+                  <Circle
+                    cx={x}
+                    cy={y}
+                    r="13"
+                    fill="transparent"
+                    {...webHover(() => {
+                      setHoveredIndex(null);
+                      setHoveredPreviousIndex(
+                        index
+                      );
+                    }, () =>
+                      setHoveredPreviousIndex(
+                        null
+                      )
+                    )}
+                    onPress={() => {
+                      setHoveredIndex(null);
+                      setHoveredPreviousIndex(
+                        index
+                      );
+                    }}
+                  />
+
+                  <Circle
+                    cx={x}
+                    cy={y}
+                    r={active ? "5.5" : "4"}
+                    fill="#FFFFFF"
+                    stroke={
+                      compact
+                        ? "#8B5CF6"
+                        : pointColor
+                    }
+                    strokeWidth={
+                      active
+                        ? compact
+                          ? "2.5"
+                          : "2.8"
+                        : compact
+                          ? "1.8"
+                          : "2"
+                    }
+                    opacity={
+                      active
+                        ? "1"
+                        : compact
+                          ? "0.62"
+                          : "0.68"
+                    }
+                    pointerEvents="none"
+                  />
+
+                  <Circle
+                    cx={x}
+                    cy={y}
+                    r="1.8"
+                    fill={
+                      compact
+                        ? "#8B5CF6"
+                        : pointColor
+                    }
+                    opacity={
+                      compact ? "0.72" : "0.82"
+                    }
+                    pointerEvents="none"
+                  />
+                </React.Fragment>
+              );
+            }
+          )}
+
+          {/* CURRENT PERIOD */}
+          <Path
+            d={makePath()}
+            fill="none"
+            stroke={metricColor}
+            strokeWidth={
+              compact ? "3.35" : "3"
+            }
+            strokeLinecap="round"
+            strokeLinejoin="round"
+          />
+
+          {buckets.map(
+            (bucket, index) => {
+              const value = finite(
+                bucket[metricKey]
+              );
+
+              const x =
+                xAt(index);
+
+              const y =
+                yAt(value);
+
+              const pointColor =
+                metric ===
+                  "NET_PROFIT" &&
+                value < 0
+                  ? LOSS_COLOR
+                  : metricColor;
+
+              return (
+                <React.Fragment
+                  key={bucket.key}
+                >
+                  {/* Vertical guide */}
+                  <Line
+                    x1={x}
+                    x2={x}
+                    y1={
+                      top +
+                      plotHeight
+                    }
+                    y2={
+                      top +
+                      plotHeight +
+                      4
+                    }
+                    stroke="#CBD5E1"
+                    strokeWidth="1"
+                  />
+
+                  {/* Interactive hit target */}
+                  <Circle
+                    cx={x}
+                    cy={y}
+                    r="13"
+                    fill="transparent"
+                    {...webHover(() => {
+                      setHoveredPreviousIndex(
+                        null
+                      );
+                      setHoveredIndex(index);
+                    }, () =>
+                      setHoveredIndex(null)
+                    )}
+                    onPress={() =>
+                      setHoveredIndex(index)
+                    }
+                  />
+
+                  {/* Data point */}
+                  <Circle
+                    cx={x}
+                    cy={y}
+                    r={
+                      hoveredIndex === index
+                        ? "6"
+                        : "5"
+                    }
+                    fill="#FFFFFF"
+                    stroke={pointColor}
+                    strokeWidth={
+                      hoveredIndex === index
+                        ? "3"
+                        : "2.5"
+                    }
+                    pointerEvents="none"
+                  />
+
+                  <Circle
+                    cx={x}
+                    cy={y}
+                    r="2"
+                    fill={pointColor}
+                  />
+
+                  {/* X-axis period label */}
+                  {shouldShowXLabel(
+                    index
+                  ) && (
+                    <SvgText
+                      x={x}
+                      y={
+                        top +
+                        plotHeight +
+                        17
+                      }
+                      textAnchor="middle"
+                      fontSize="10.5"
+                      fontWeight="800"
+                      fill={TEXT_COLOR}
+                    >
+                      {
+                        bucket.shortLabel
+                      }
+                    </SvgText>
+                  )}
+                </React.Fragment>
+              );
+            }
+          )}
+        </>
+      )}
+
+      {/* PROFESSIONAL FINANCIAL TOOLTIP */}
+      {hoveredBucket &&
+        activeHoveredIndex !== null && (() => {
+          const denominator =
+            hoveredIsPrevious
+              ? Math.max(
+                  1,
+                  previousBuckets.length - 1
+                )
+              : Math.max(
+                  1,
+                  buckets.length - 1
+                );
+
+          const pointX =
+            hoveredIsPrevious
+              ? previousBuckets.length <= 1
+                ? left + plotWidth / 2
+                : left +
+                  (
+                    activeHoveredIndex /
+                    denominator
+                  ) *
+                    plotWidth
+              : xAt(
+                  activeHoveredIndex
+                );
+
+          const pointY =
+            yAt(
+              hoveredBucket[
+                metricKey
+              ]
+            );
+
+          const tooltipWidth = 184;
+          const tooltipHeight = 102;
+
+          const tooltipX =
+            pointX >
+            width -
+              tooltipWidth -
+              14
+              ? pointX -
+                tooltipWidth -
+                12
+              : pointX + 12;
+
+          const tooltipY =
+            Math.max(
+              6,
+              Math.min(
+                height -
+                  tooltipHeight -
+                  6,
+                pointY -
+                  tooltipHeight /
+                    2
+              )
+            );
+
+          const profit =
+            finite(
+              hoveredBucket.netProfit
+            );
+
+          return (
+            <React.Fragment>
+              {/* Subtle tooltip depth */}
+              <Rect
+                x={tooltipX + 2}
+                y={tooltipY + 4}
+                width={tooltipWidth}
+                height={tooltipHeight}
+                rx="11"
+                fill="#020617"
+                opacity="0.16"
+                pointerEvents="none"
+              />
+
+              {/* Premium tooltip surface */}
+              <Rect
+                x={tooltipX}
+                y={tooltipY}
+                width={tooltipWidth}
+                height={tooltipHeight}
+                rx="11"
+                fill="#0F172A"
+                stroke="#334155"
+                strokeWidth="1"
+                opacity="0.985"
+                pointerEvents="none"
+              />
+
+              {/* Period heading */}
+              <SvgText
+                x={tooltipX + 12}
+                y={tooltipY + 20}
+                fontSize="11.5"
+                fontWeight="900"
+                fill="#FFFFFF"
+                pointerEvents="none"
+              >
+                {hoveredIsPrevious
+                  ? uiText("Previous • {p0}", {p0: (hoveredBucket.label)})
+                  : hoveredBucket.label}
+              </SvgText>
+
+              {/* Header divider */}
+              <Rect
+                x={tooltipX + 12}
+                y={tooltipY + 29}
+                width={tooltipWidth - 24}
+                height="1"
+                fill="#334155"
+                opacity="0.9"
+                pointerEvents="none"
+              />
+
+              {/* Sales */}
+              <Rect
+                x={tooltipX + 12}
+                y={tooltipY + 41}
+                width="6"
+                height="6"
+                rx="3"
+                fill="#3B82F6"
+                pointerEvents="none"
+              />
+
+              <SvgText
+                x={tooltipX + 25}
+                y={tooltipY + 48}
+                fontSize="10"
+                fontWeight="800"
+                fill="#E2E8F0"
+                pointerEvents="none"
+              >
+                {uiText("Sales  {p0}", {p0: (moneyCompact(
+                  hoveredBucket.sales
+                ))})}
+              </SvgText>
+
+              {/* Expenses */}
+              <Rect
+                x={tooltipX + 12}
+                y={tooltipY + 61}
+                width="6"
+                height="6"
+                rx="3"
+                fill="#F59E0B"
+                pointerEvents="none"
+              />
+
+              <SvgText
+                x={tooltipX + 25}
+                y={tooltipY + 68}
+                fontSize="10"
+                fontWeight="800"
+                fill="#FBBF24"
+                pointerEvents="none"
+              >
+                {uiText("Expenses  {p0}", {p0: (moneyCompact(
+                  hoveredBucket.expenses
+                ))})}
+              </SvgText>
+
+              {/* Net Profit / Loss */}
+              <Rect
+                x={tooltipX + 12}
+                y={tooltipY + 81}
+                width="6"
+                height="6"
+                rx="3"
+                fill={
+                  profit < 0
+                    ? LOSS_COLOR
+                    : PROFIT_COLOR
+                }
+                pointerEvents="none"
+              />
+
+              <SvgText
+                x={tooltipX + 25}
+                y={tooltipY + 88}
+                fontSize="10"
+                fontWeight="900"
+                fill={
+                  profit < 0
+                    ? LOSS_COLOR
+                    : "#4ADE80"
+                }
+                pointerEvents="none"
+              >
+                {profit < 0
+                  ? uiText("Loss  {p0}", {p0: (moneyCompact(
+                      Math.abs(profit)
+                    ))})
+                  : uiText("Net Profit  {p0}", {p0: (moneyCompact(
+                      profit
+                    ))})}
+              </SvgText>
+            </React.Fragment>
+          );
+        })()}
+    </Svg>
+  );
+}
