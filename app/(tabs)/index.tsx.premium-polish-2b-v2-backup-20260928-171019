            onOpenBusinessDebts={goBusinessDebts}
            onOpenIncomingStock={goIncomingStock}
            onOpenStock={goStockValue}
          />

            <View style={{ flex: 1, minHeight: 0 }} />
            <ZetraAiCard onOpen={goAI} />
          </View>
        </StoreGuard>
      )}
    </Screen>
  );
}















