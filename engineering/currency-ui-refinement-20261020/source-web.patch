+function BarsChart({
+  buckets,
+  width,
+  height,
+}: {
+  buckets: FinancialBucketResult[];
+  width: number;
+  height: number;
+}) {
+  const left = 36;
+  const right = 10;
+  const top = 14;
+  const bottom = 34;
+
+  const plotWidth =
+    Math.max(
+      1,
+      width -
+        left -
+        right
+    );
+
+  const plotHeight =
+    Math.max(
+      1,
+      height -
+        top -
+        bottom
+    );
+
+  const values =
+    buckets.flatMap(
+      (bucket) => [
+        finite(
+          bucket.sales
+        ),
+        finite(
+          bucket.expenses
+        ),
+        Math.abs(
+          finite(
+            bucket.netProfit
+          )
+        ),
+      ]
+    );
+
+  const max =
+    Math.max(
+      1,
+      ...values
+    );
+
+  const groupWidth =
+    plotWidth /
+    Math.max(
+      1,
+      buckets.length
+    );
+
+  const barWidth =
+    Math.max(
+      3,
+      Math.min(
+        14,
+        groupWidth /
+          5
+      )
+    );
+
+  const barHeight = (
+    value: number
+  ) =>
+    (Math.abs(
+      finite(value)
+    ) /
+      max) *
+    plotHeight;
+
+  return (
+    <Svg
+      width={width}
+      height={height}
+    >
+      {[0, 0.25, 0.5, 0.75, 1].map(
+        (ratio) => {
+          const y =
+            top +
+            plotHeight *
+              ratio;
+
+          return (
+            <Line
+              key={
+                ratio
+              }
+              x1={left}
+              x2={
+                width -
+                right
+              }
+              y1={y}
+              y2={y}
+              stroke={
+                GRID_COLOR
+              }
+              strokeWidth="1"
+            />
+          );
+        }
+      )}
+
+      {buckets.map(
+        (
+          bucket,
+          index
+        ) => {
+          const center =
+            left +
+            groupWidth *
+              index +
+            groupWidth /
+              2;
+
+          const salesH =
+            barHeight(
+              bucket.sales
+            );
+
+          const expenseH =
+            barHeight(
+              bucket.expenses
+            );
+
+          const profitH =
+            barHeight(
+              bucket.netProfit
+            );
+
+          return (
+            <React.Fragment
+              key={
+                bucket.key
+              }
+            >
+              <Rect
+                x={
+                  center -
+                  barWidth *
+                    1.6
+                }
+                y={
+                  top +
+                  plotHeight -
+                  salesH
+                }
+                width={
+                  barWidth
+                }
+                height={
+                  salesH
+                }
+                rx="2"
+                fill={
+                  SALES_COLOR
+                }
+              />
+
+              <Rect
+                x={
+                  center -
+                  barWidth /
+                    2
+                }
+                y={
+                  top +
+                  plotHeight -
+                  expenseH
+                }
+                width={
+                  barWidth
+                }
+                height={
+                  expenseH
+                }
+                rx="2"
+                fill={
+                  EXPENSE_COLOR
+                }
+              />
+
+              <Rect
+                x={
+                  center +
+                  barWidth *
+                    0.6
+                }
+                y={
+                  top +
+                  plotHeight -
+                  profitH
+                }
+                width={
+                  barWidth
+                }
+                height={
+                  profitH
+                }
+                rx="2"
+                fill={
+                  bucket.netProfit <
+                  0
+                    ? LOSS_COLOR
+                    : PROFIT_COLOR
+                }
+              />
+
+              <SvgText
+                x={center}
+                y={
+                  height -
+                  9
+                }
+                textAnchor="middle"
+                fontSize="10.5"
+                fontWeight="800"
+                fill={
+                  TEXT_COLOR
+                }
+              >
+                {
+                  bucket.shortLabel
+                }
+              </SvgText>
+            </React.Fragment>
+          );
+        }
+      )}
+    </Svg>
+  );
+}
