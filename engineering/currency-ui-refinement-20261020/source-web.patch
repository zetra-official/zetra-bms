-
-  return Number.isFinite(parsed)
-    ? parsed
-    : 0;
-}
-
-function moneyCompact(
-  value: number
-) {
-  const amount =
-    Math.abs(finite(value));
-
-  if (amount >= 1_000_000_000) {
-    return `${(
-      amount /
-      1_000_000_000
-    ).toFixed(1)}B`;
-  }
-
-  if (amount >= 1_000_000) {
-    return `${(
-      amount /
-      1_000_000
-    ).toFixed(1)}M`;
-  }
-
-  if (amount >= 1_000) {
-    return `${(
-      amount /
-      1_000
-    ).toFixed(1)}K`;
-  }
-
-  return Math.round(
-    amount
-  ).toLocaleString("en-US");
-}
-
-function moneyFull(
-  value: number
-) {
-  try {
-    return `TSh ${Math.round(
-      finite(value)
-    ).toLocaleString("en-US")}`;
-  } catch {
-    return `TSh ${Math.round(
-      finite(value)
-    )}`;
-  }
-}
-
-function polarPoint(
-  cx: number,
-  cy: number,
-  radius: number,
-  angle: number
-) {
-  const radians =
-    ((angle - 90) *
-      Math.PI) /
-    180;
-
-  return {
-    x:
-      cx +
-      radius *
-        Math.cos(radians),
-    y:
-      cy +
-      radius *
-        Math.sin(radians),
-  };
-}
-
-function donutArc(
-  cx: number,
-  cy: number,
-  radius: number,
-  startAngle: number,
-  endAngle: number
-) {
-  const start =
-    polarPoint(
-      cx,
-      cy,
-      radius,
-      endAngle
-    );
-
-  const end =
-    polarPoint(
-      cx,
-      cy,
-      radius,
-      startAngle
-    );
-
-  const largeArc =
-    endAngle -
-      startAngle <=
-    180
-      ? 0
-      : 1;
-
-  return [
-    "M",
-    start.x,
-    start.y,
-    "A",
-    radius,
-    radius,
-    0,
-    largeArc,
-    0,
-    end.x,
-    end.y,
-  ].join(" ");
-}
-
-function DonutChart({
-  total,
-  width,
-  height,
-}: {
-  total: FinancialMetric;
-  width: number;
-  height: number;
-}) {
- const uiText = useCommonText();
-  /*
-   * Donut is a financial composition view.
-   *
-   * We deliberately use absolute magnitudes
-   * for visual proportions. Negative profit
-   * is rendered as Loss using red.
-   */
-  const profit =
-    finite(
-      total.netProfit
-    );
-
-  const values = [
-    {
-      key: "sales",
-      label: "Sales",
-      value: Math.max(
-        0,
-        finite(total.sales)
-      ),
-      color: SALES_COLOR,
-    },
-    {
-      key: "expenses",
-      label: "Expenses",
-      value: Math.max(
-        0,
-        finite(
-          total.expenses
-        )
-      ),
-      color: EXPENSE_COLOR,
-    },
-    {
-      key: "profit",
-      label:
-        profit < 0
-          ? "Loss"
-          : "Net Profit",
-      value: Math.abs(
-        profit
-      ),
-      color:
-        profit < 0
-          ? LOSS_COLOR
-          : PROFIT_COLOR,
-    },
-  ];
-
-  const sum =
-    values.reduce(
-      (acc, item) =>
-        acc +
-        item.value,
-      0
-    );
-
-  const cx =
-    width / 2;
-
-  const cy =
-    height / 2;
-
-  const radius =
-    Math.min(
-      width,
-      height
-    ) * 0.36;
-
-  const strokeWidth =
-    Math.max(
-      18,
-      radius * 0.24
-    );
-
-  let angle = 0;
-
-  return (
-    <View
-      style={{
-        width,
-        height,
-        alignItems:
-          "center",
-        justifyContent:
-          "center",
-      }}
-    >
-      <Svg
-        width={width}
-        height={height}
-      >
-        <Circle
-          cx={cx}
-          cy={cy}
-          r={radius}
-          fill="none"
-          stroke="#EEF2F7"
-          strokeWidth={
-            strokeWidth
-          }
-        />
-
-        {sum > 0 &&
-          values.map(
-            (item) => {
-              if (
-                item.value <= 0
-              ) {
-                return null;
-              }
-
-              const sweep =
-                (item.value /
-                  sum) *
-                360;
-
-              const gap =
-                Math.min(
-                  2.5,
-                  sweep * 0.12
-                );
-
-              const start =
-                angle +
-                gap / 2;
-
-              const end =
-                angle +
-                sweep -
-                gap / 2;
-
-              angle +=
-                sweep;
-
-              if (
-                end <= start
-              ) {
-                return null;
-              }
-
-              return (
-                <Path
-                  key={
-                    item.key
-                  }
-                  d={donutArc(
-                    cx,
-                    cy,
-                    radius,
-                    start,
-                    end
-                  )}
-                  fill="none"
-                  stroke={
-                    item.color
-                  }
-                  strokeWidth={
-                    strokeWidth
-                  }
-                  strokeLinecap="round"
-                />
-              );
-            }
-          )}
-
-        <SvgText
-          x={cx}
-          y={cy - 7}
-          textAnchor="middle"
-          fontSize="9"
-          fontWeight="800"
-          fill="#64748B"
-        >
-          {uiText("BUSINESS")}</SvgText>
-
-        <SvgText
-          x={cx}
-          y={cy + 10}
-          textAnchor="middle"
-          fontSize="13"
-          fontWeight="900"
-          fill="#0F172A"
-        >
-          {uiText("OVERVIEW")}</SvgText>
-      </Svg>
-    </View>
-  );
-}
-
-function TrendChart({
-  buckets,
-  previousBuckets = [],
-  width,
-  height,
-  metric = "SALES",
-  compact = false,
-}: {
-  buckets: FinancialBucketResult[];
-  previousBuckets?: FinancialBucketResult[];
-  width: number;
-  height: number;
-  metric?: FinancialTrendMetric;
-  compact?: boolean;
-}) {
- const uiText = useCommonText();
-  /*
-   * Professional finance chart layout.
-   *
-   * Left space is deliberately larger so financial
-   * values never collide with the plot.
-   *
-   * Bottom space is reserved for the time axis.
-   */
-  const [hoveredIndex, setHoveredIndex] =
-    React.useState<number | null>(null);
-
-  const [
-    hoveredPreviousIndex,
-    setHoveredPreviousIndex,
-  ] = React.useState<number | null>(null);
-
-  const hoveredIsPrevious =
-    hoveredPreviousIndex !== null;
-
-  const activeHoveredIndex =
-    hoveredIsPrevious
-      ? hoveredPreviousIndex
-      : hoveredIndex;
-
-  const hoveredBucket =
-    activeHoveredIndex !== null
-      ? (
-          hoveredIsPrevious
-            ? previousBuckets[
-                activeHoveredIndex
-              ]
-            : buckets[
-                activeHoveredIndex
-              ]
-        ) ?? null
-      : null;
-
-  const left = 58;
-  const right = 12;
-  const top = 18;
-  const bottom = 38;
-
-  const plotWidth = Math.max(
-    1,
-    width - left - right
-  );
-
-  const plotHeight = Math.max(
-    1,
-    height - top - bottom
-  );
-
-  const metricKey:
-    | "sales"
-    | "expenses"
-    | "netProfit" =
-    metric === "EXPENSES"
-      ? "expenses"
-      : metric === "NET_PROFIT"
-        ? "netProfit"
-        : "sales";
-
-  const metricColor =
-    metric === "EXPENSES"
-      ? EXPENSE_COLOR
-      : metric === "NET_PROFIT"
-        ? PROFIT_COLOR
-        : SALES_COLOR;
-
-  const values = buckets.map(
-    (bucket) =>
-      finite(bucket[metricKey])
-  );
-
-  const previousValues =
-    previousBuckets.map(
-      (bucket) =>
-        finite(bucket[metricKey])
-    );
-
-  const scaleValues = [
-    ...values,
-    ...previousValues,
-  ];
-
-  /*
-   * Financial charts always retain zero.
-   * Net Profit is allowed to cross below zero.
-   */
-  const minValue = Math.min(
-    0,
-    ...scaleValues
-  );
-
-  const maxValue = Math.max(
-    0,
-    ...scaleValues
-  );
-
-  const rawRange =
-    maxValue - minValue;
-
-  const range = Math.max(
-    1,
-    rawRange
-  );
-
-  /*
-   * Give both ends breathing room.
-   */
