import React from "react";

import {
  Modal,
  Pressable,
  Text,
  View,
  useWindowDimensions,
} from "react-native";

import FinancialChart, {
  type FinancialTrendMetric,
} from "./FinancialChart";

import type {
  FinancialOverviewResult,
} from "./financialDataEngine";

import type {
  FinancialPeriodMode,
} from "./periodEngine";

type PeriodOption = {
  value: FinancialPeriodMode;
  label: string;
};

type MetricOption = {
  value: FinancialTrendMetric;
  label: string;
  color: string;
  activeBackground: string;
};

type Props = {
  visible: boolean;
  onClose: () => void;

  result: FinancialOverviewResult;

  periodMode: FinancialPeriodMode;
  onPeriodChange: (
    value: FinancialPeriodMode
  ) => void;

  selectedMetric: FinancialTrendMetric;
  onMetricChange: (
    value: FinancialTrendMetric
  ) => void;

  periodOptions: PeriodOption[];
  metricOptions: MetricOption[];

  rangeLabel: string;
  periodLabel: string;

  loading?: boolean;
  errorText?: string;
};

function money(
  value: number
) {
  const amount = Number.isFinite(value)
    ? value
    : 0;

  return new Intl.NumberFormat(
    "en-US",
    {
      maximumFractionDigits: 0,
    }
  ).format(amount);
}

function MetricCard({
  label,
  value,
  color,
  subtitle,
}: {
  label: string;
  value: number;
  color: string;
  subtitle: string;
}) {
  return (
    <View
      style={{
        flex: 1,
        minWidth: 180,
        borderWidth: 1,
        borderColor: "#E2E8F0",
        borderRadius: 16,
        backgroundColor: "#FFFFFF",
        paddingHorizontal: 16,
        paddingVertical: 11,
      }}
    >
      <View
        style={{
          flexDirection: "row",
          alignItems: "center",
          gap: 8,
        }}
      >
        <View
          style={{
            width: 9,
            height: 9,
            borderRadius: 999,
            backgroundColor: color,
          }}
        />

        <Text
          style={{
            color: "#64748B",
            fontSize: 12,
            fontWeight: "800",
          }}
        >
          {label}
        </Text>
      </View>

      <Text
        style={{
          marginTop: 6,
          color: "#0F172A",
          fontSize: 20,
          fontWeight: "900",
        }}
      >
        TSh {money(value)}
      </Text>

      <Text
        style={{
          marginTop: 5,
          color: "#94A3B8",
          fontSize: 10,
          fontWeight: "700",
        }}
      >
        {subtitle}
      </Text>
    </View>
  );
}

export default function FinancialOverviewFullView({
  visible,
  onClose,
  result,
  periodMode,
  onPeriodChange,
  selectedMetric,
  onMetricChange,
  periodOptions,
  metricOptions,
  rangeLabel,
  periodLabel,
  loading = false,
  errorText = "",
