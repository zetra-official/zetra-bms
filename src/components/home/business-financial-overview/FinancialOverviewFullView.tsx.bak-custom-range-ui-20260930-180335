                          />

                          <Text
                            style={{
                              color: selected
                                ? option.color
                                : "#64748B",
                              fontSize: 10,
                              fontWeight: "900",
                            }}
                          >
                            {option.label}
                          </Text>
                        </Pressable>
                      );
                    }
                  )}
                </View>
              </View>

              {loading ? (
                <View
                  style={{
                    minHeight: chartHeight,
                    alignItems: "center",
                    justifyContent:
                      "center",
                  }}
                >
                  <Text
                    style={{
                      color: "#64748B",
                      fontSize: 12,
                      fontWeight: "800",
                    }}
                  >
                    Loading verified finance data...
                  </Text>
                </View>
              ) : errorText ? (
                <View
                  style={{
                    minHeight: chartHeight,
                    alignItems: "center",
                    justifyContent:
                      "center",
                    paddingHorizontal: 20,
                  }}
                >
                  <Text
                    style={{
                      color: "#B91C1C",
                      fontSize: 12,
                      fontWeight: "800",
                      textAlign: "center",
                    }}
                  >
                    {errorText}
                  </Text>
                </View>
              ) : (
                <View
                  style={{
                    marginTop: 8,
                    flex: 1,
                    minHeight: 0,
                    width: "100%",
                    overflow: "hidden",
                    alignItems: "center",
                    justifyContent: "center",
                  }}
                >
                  <FinancialChart
                    mode="TREND"
                    metric={
                      selectedMetric
                    }
                    total={result.total}
                    buckets={
                      result.buckets
                    }
                    width={chartWidth}
                    height={chartHeight}
                  />
                </View>
              )}
            </View>

            <Text
              style={{
                marginTop: 5,
                color: "#64748B",
                fontSize: 8,
                fontWeight: "700",
                textAlign: "center",
              }}
            >
              ZETRA Business Financial Intelligence
            </Text>
          </View>
        </View>
      </View>
    </Modal>
  );
}

