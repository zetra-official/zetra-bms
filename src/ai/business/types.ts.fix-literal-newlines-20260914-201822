export interface ZetraAiBusinessScope {
  organizationId: string;

  storeId: string | null;
  storeName?: string | null;

  timezone: string;

  role?: string | null;
}

export interface ZetraAiDateRange {
  preset: ZetraAiPeriodPreset;

  fromDate: string;
  toDate: string;

  timezone: string;
}

export interface ZetraAiComparisonRange {
  mode: ZetraAiComparisonMode;

  fromDate: string | null;
  toDate: string | null;
}

export interface ZetraAiBusinessQuery {
  /**
   * Original natural-language question.
   *
   * Example:
   * "Leo biashara yangu imeendaje ukilinganisha na jana?"
   */
  originalText: string;

  domain: ZetraAiBusinessDomain;

  intent: ZetraAiBusinessIntent;

  scope: ZetraAiBusinessScope;

  period: ZetraAiDateRange;

  comparison: ZetraAiComparisonRange;

  /**
   * Semantic confidence returned by the language intelligence layer.
   */
  confidence: number;

  /**
   * Optional explanation useful for debugging/observability.
   * Never use this as financial truth.
   */
  reasoning?: string | null;
}

