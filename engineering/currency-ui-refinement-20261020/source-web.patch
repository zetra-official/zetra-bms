-
-          return `${
-            index === 0 ? "M" : "L"
-          } ${x} ${y}`;
-        }
-      );
-
-    const previousPoints =
-      Array.from(
-        { length: pointCount },
-        (_, reverseIndex) => {
-          const index =
-            pointCount -
-            1 -
-            reverseIndex;
-
-          const x = xForPoint(index);
-          const y = yAt(
-            previousBuckets[index][
-              metricKey
