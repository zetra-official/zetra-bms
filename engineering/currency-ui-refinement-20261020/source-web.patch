-
-      {/* PROFESSIONAL FINANCIAL TOOLTIP */}
-      {hoveredBucket &&
-        activeHoveredIndex !== null && (() => {
-          const denominator =
-            hoveredIsPrevious
-              ? Math.max(
-                  1,
-                  previousBuckets.length - 1
-                )
-              : Math.max(
-                  1,
-                  buckets.length - 1
-                );
-
-          const pointX =
-            hoveredIsPrevious
-              ? previousBuckets.length <= 1
-                ? left + plotWidth / 2
-                : left +
-                  (
-                    activeHoveredIndex /
