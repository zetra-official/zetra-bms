/**
 * Complete verified business intelligence package.
 *
 * This is what the language model should receive instead of being
 * allowed to query operational business tables freely.
 */
export interface ZetraAiBusinessIntelligence {
  scope: ZetraAiBusinessScope;

  period: ZetraAiDateRange;

  comparisonPeriod?: ZetraAiComparisonRange | null;

  metrics: ZetraAiBusinessMetrics;

  comparison?: ZetraAiBusinessComparison | null;

  trend: ZetraAiBusinessTrendPoint[];

  insights: ZetraAiBusinessInsight[];

  actions: ZetraAiBusinessAction[];

  /**
   * Canonical source metadata.
   */
  source: {
    engine: "AI_DAILY_STORE_SNAPSHOTS_V1";
    verified: true;

    snapshotCount: number;

    generatedAt: string;
  };
}

/**
 * ============================================================================
 * BUSINESS BRIDGE RESULT
 * ============================================================================
 *
 * The bridge should fail explicitly rather than silently supplying fake
 * or incomplete business numbers to OpenAI.
 * ============================================================================
 */

export type ZetraAiBusinessBridgeResult =
  | {
      ok: true;

      query: ZetraAiBusinessQuery;

      intelligence: ZetraAiBusinessIntelligence;
    }
  | {
      ok: false;

      code:
        | "NOT_BUSINESS_QUERY"
        | "STORE_REQUIRED"
        | "UNAUTHORIZED"
        | "INVALID_PERIOD"
        | "NO_SNAPSHOT_DATA"
        | "DATA_ENGINE_ERROR"
        | "UNSUPPORTED_INTENT";

      error: string;

      query?: ZetraAiBusinessQuery | null;
    };

/**
 * ============================================================================
 * LANGUAGE → BUSINESS INTENT CONTRACT
 * ============================================================================
 *
 * OpenAI can understand language.
 * It cannot decide financial truth.
 *
 * Example:
 *
 * User:
 * "Leo hali yangu ikoje ukilinganisha jana?"
 *
 * Language layer:
 * {
 *   domain: "PERFORMANCE",
 *   intent: "PERIOD_COMPARISON",
 *   periodPreset: "TODAY",
 *   comparisonMode: "PREVIOUS_DAY"
 * }
 *
 * Business engine then retrieves the verified numbers.
 * ============================================================================
 */

export interface ZetraAiSemanticBusinessIntent {
  isBusinessQuery: boolean;

  domain: ZetraAiBusinessDomain;

  intent: ZetraAiBusinessIntent;

  periodPreset: ZetraAiPeriodPreset;

  comparisonMode: ZetraAiComparisonMode;

  /**
   * Only populated when user explicitly specifies dates.
   */
  customFromDate?: string | null;
  customToDate?: string | null;`r`n`r`n  /** Exact rolling-day window requested by the user. */`r`n  rollingDays?: number | null;

  confidence: number;

  /**
   * Short machine/debug explanation.
   */
  reason?: string | null;
}