export default function SalesPerformanceWorkspace({
  orgId,
  storeId,
  formatMoney,
}: Props) {
  const money =
    formatMoney ?? defaultMoney;

  const [mode, setMode] =
    React.useState<SalesPerformanceMode>(
      "DAILY"
    );

  const [compare, setCompare] =
    React.useState(true);

  const [performance, setPerformance] =
    React.useState<SalesPerformanceResult | null>(
      null
    );

  const [intelligence, setIntelligence] =
    React.useState<SalesIntelligenceResult | null>(
      null
    );

  const [loading, setLoading] =
    React.useState(false);

  const [errorText, setErrorText] =
    React.useState("");

  const requestRef =
    React.useRef(0);

  const load = React.useCallback(
    async () => {
      const cleanOrgId =
        String(orgId || "").trim();

      const cleanStoreId =
        String(storeId || "").trim();

      if (
        !cleanOrgId ||
        !cleanStoreId
      ) {
        setPerformance(null);
        setIntelligence(null);
        setErrorText("");
        return;
      }

      const requestId =
        ++requestRef.current;

      setLoading(true);
      setErrorText("");

      try {
        /*
         * Stage 1:
         * exactly TWO get_sales_v3 requests:
         * current + previous.
         */
        const nextPerformance =
          await loadSalesPerformance({
            storeId: cleanStoreId,
            mode,
          });

        if (
          requestId !==
          requestRef.current
        ) {
          return;
        }

        setPerformance(
          nextPerformance
        );

        /*
         * Stage 2:
         * payment mix + top products.
         *
         * Peak time can still use the already
         * bucketed performance points without
         * introducing another Home-level query.
         */
        const peakRows =
          nextPerformance.currentPoints.map(
            (point, index) => {
              const periods =
                resolveSalesPerformancePeriods(
                  mode
                );

              const bucket =
                periods.currentBuckets[
                  index
                ];

              return {
                soldAt:
                  bucket?.from.toISOString() ??
                  new Date().toISOString(),
                totalAmount:
                  finite(point.sales),
              };
            }
          );

        const nextIntelligence =
          await loadSalesIntelligence({
            orgId: cleanOrgId,
            storeId: cleanStoreId,
            range:
              nextPerformance.currentRange,
            currentSalesRows:
              peakRows,
          });

        if (
          requestId !==
          requestRef.current
        ) {
          return;
        }

        setIntelligence(
          nextIntelligence
        );
      } catch (error: any) {
        if (
          requestId !==
          requestRef.current
        ) {
          return;
        }

        setErrorText(
          error?.message
            ? String(error.message)
            : "Unable to load Sales Performance."
        );
      } finally {
        if (
          requestId ===
          requestRef.current
        ) {
          setLoading(false);
        }
      }
    },
    [
      orgId,
      storeId,
      mode,
    ]
  );

  React.useEffect(() => {
    load();

    return () => {
      requestRef.current += 1;
    };
  }, [load]);

  const periods =
    React.useMemo(
      () =>
        resolveSalesPerformancePeriods(
          mode
        ),
      [mode]
    );

  const rangeLabel =
    formatSalesPerformanceRange(
      performance?.currentRange ??
        periods.current
    );

  const differencePositive =
    finite(
      performance?.difference.amount
    ) >= 0;

  return (
    <View
      style={{
        width: "100%",
        backgroundColor: PANEL,
        borderWidth: 1,
        borderColor: BORDER,
        borderRadius: 18,
        overflow: "hidden",
      }}
    >
      <View
        style={{
          paddingHorizontal: 20,
          paddingTop: 18,
          paddingBottom: 14,
          borderBottomWidth: 1,
          borderBottomColor: BORDER,
        }}
      >
        <View
          style={{
            flexDirection: "row",
            alignItems: "center",
            justifyContent:
              "space-between",
            gap: 16,
            flexWrap: "wrap",
          }}
        >
          <View>
            <View
              style={{
                flexDirection: "row",
                alignItems: "center",
                gap: 9,
              }}
            >
              <View
                style={{
                  width: 30,
                  height: 30,
                  borderRadius: 9,
                  backgroundColor:
                    BLUE_SOFT,
                  alignItems: "center",
                  justifyContent:
                    "center",
                }}
              >
                <Text
                  style={{
                    color: BLUE,
                    fontSize: 17,
                    fontWeight: "900",
                  }}
                >
                  ↗
                </Text>
              </View>

              <Text
                style={{
                  color: TEXT,
                  fontSize: 20,
                  fontWeight: "900",
                }}
              >
                Sales Performance
              </Text>
            </View>

            <Text
              style={{
                color: MUTED,
                fontSize: 11,
                marginTop: 5,
              }}
            >
              Visualize your sales trends and compare performance over time
            </Text>
          </View>

          <View
            style={{
              flexDirection: "row",
              alignItems: "center",
              gap: 12,
              flexWrap: "wrap",
            }}
          >
            <View
              style={{
                flexDirection: "row",
                backgroundColor: SOFT,
                borderRadius: 10,
                padding: 3,
                borderWidth: 1,
                borderColor: BORDER,
              }}
            >
              <ModeButton
                label="Daily"
                active={
                  mode === "DAILY"
                }
                onPress={() =>
                  setMode("DAILY")
                }
              />

              <ModeButton
                label="Weekly"
                active={
                  mode === "WEEKLY"
                }
                onPress={() =>
                  setMode("WEEKLY")
                }
              />

              <ModeButton
                label="Monthly"
                active={
                  mode === "MONTHLY"
                }
                onPress={() =>
                  setMode("MONTHLY")
                }
              />
            </View>

            <Pressable
              onPress={() =>
                setCompare(
                  (value) => !value
                )
              }
              style={{
                flexDirection: "row",
                alignItems: "center",
                gap: 8,
              }}
            >
              <Text
                style={{
                  color: TEXT,
                  fontSize: 11,
                  fontWeight: "800",
                }}
              >
                Compare
              </Text>

              <View
                style={{
                  width: 36,
                  height: 20,
                  borderRadius: 999,
                  padding: 2,
                  backgroundColor:
                    compare
                      ? BLUE
                      : "#CBD5E1",
                  alignItems:
                    compare
                      ? "flex-end"
                      : "flex-start",
                }}
              >
                <View
                  style={{
                    width: 16,
                    height: 16,
                    borderRadius: 999,
                    backgroundColor:
                      "#FFFFFF",
                  }}
                />
              </View>
            </Pressable>

            <View
              style={{
                minHeight: 36,
                paddingHorizontal: 12,
                borderRadius: 9,
                borderWidth: 1,
                borderColor: BORDER,
                backgroundColor: PANEL,
                justifyContent:
                  "center",
              }}
            >
              <Text
                style={{
                  color: TEXT,
                  fontSize: 10,
                  fontWeight: "800",
                }}
              >
                {rangeLabel}
              </Text>
            </View>
          </View>
        </View>
      </View>

      {loading &&
      !performance ? (
        <View
          style={{
            minHeight: 420,
            alignItems: "center",
            justifyContent:
              "center",
          }}
        >
          <ActivityIndicator
            size="large"
            color={BLUE}
          />

          <Text
            style={{
              color: MUTED,
              marginTop: 12,
              fontSize: 12,
              fontWeight: "700",
            }}
          >
            Loading verified sales performance...
          </Text>
        </View>
      ) : errorText &&
        !performance ? (
        <View
          style={{
            minHeight: 300,
            alignItems: "center",
            justifyContent:
              "center",
            padding: 30,
          }}
        >
          <Text
            style={{
              color: RED,
              fontSize: 13,
              fontWeight: "900",
            }}
          >
            Sales Performance unavailable
          </Text>

          <Text
            style={{
              color: MUTED,
              fontSize: 11,
              marginTop: 7,
              textAlign: "center",
            }}
          >
            {errorText}
          </Text>

          <Pressable
            onPress={load}
            style={{
              marginTop: 14,
              paddingHorizontal: 16,
              paddingVertical: 9,
              borderRadius: 9,
              backgroundColor: BLUE,
            }}
          >
            <Text
              style={{
                color: "#FFFFFF",
                fontSize: 11,
                fontWeight: "900",
              }}
            >
              Retry
            </Text>
          </Pressable>
        </View>
      ) : performance ? (
        <>
          <View
            style={{
              flexDirection: "row",
              flexWrap: "wrap",
              borderBottomWidth: 1,
              borderBottomColor: BORDER,
            }}
          >
            <MetricCard
              label="TOTAL SALES"
              value={money(
                performance.current.sales
              )}
              subtext={
                performance.difference
                  .percent == null
                  ? "No previous baseline"
                  : `${percentLabel(
                      performance.difference
                        .percent
                    )} vs previous`
              }
              positive={
                differencePositive
              }
              negative={
                !differencePositive
              }
            />

            <MetricCard
              label="PREVIOUS PERIOD"
              value={money(
                performance.previous.sales
              )}
              subtext={
                compare
                  ? "Comparison enabled"
                  : "Comparison hidden"
              }
            />

            <MetricCard
              label="DIFFERENCE"
              value={`${performance.difference.amount >= 0 ? "+" : "-"}${money(
                Math.abs(
                  performance.difference
                    .amount
                )
              )}`}
              subtext={percentLabel(
                performance.difference
                  .percent
              )}
              positive={
                differencePositive
              }
              negative={
                !differencePositive
              }
            />

            <MetricCard
              label="ORDERS"
              value={performance.current.orders.toLocaleString(
                "en-US"
              )}
              subtext={`${performance.current.quantity.toLocaleString(
                "en-US"
              )} units sold`}
            />

            <MetricCard
              label="AVERAGE ORDER VALUE"
              value={money(
                performance.current
                  .averageOrderValue
              )}
              subtext="Verified completed sales"
            />
          </View>

          <View
            style={{
              paddingHorizontal: 18,
              paddingTop: 18,
              paddingBottom: 10,
            }}
          >
            <SalesPerformanceChart
              currentPoints={
                performance.currentPoints
              }
              previousPoints={
                performance.previousPoints
              }
              compare={compare}
              width={980}
              height={330}
              formatMoney={money}
            />
          </View>

          <View
            style={{
              flexDirection: "row",
              flexWrap: "wrap",
              gap: 12,
              paddingHorizontal: 18,
              paddingTop: 8,
              paddingBottom: 18,
              backgroundColor: SOFT,
            }}
          >
            {intelligence ? (
              <>
                <PaymentPanel
                  intelligence={
                    intelligence
                  }
                  money={money}
                />

                <TopProductsPanel
                  intelligence={
                    intelligence
                  }
                  money={money}
                />

                <InsightPanel
                  performance={
                    performance
                  }
                  intelligence={
                    intelligence
                  }
                  money={money}
                />
              </>
            ) : (
              <View
                style={{
                  width: "100%",
                  minHeight: 120,
                  alignItems: "center",
                  justifyContent:
                    "center",
                }}
              >
                <ActivityIndicator
                  color={BLUE}
                />

                <Text
                  style={{
                    color: MUTED,
                    fontSize: 11,
                    marginTop: 8,
                  }}
                >
                  Loading sales intelligence...
                </Text>
              </View>
            )}
          </View>

          {intelligence && (
            <View
