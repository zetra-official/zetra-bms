-  };
-
-  return (
-    <Svg
-      width={width}
-      height={height}
-    >
-      {compact && previousBuckets.length > 0 && (
-        <>
-          {/* Compact comparison legend */}
-          <Line
-            x1={left}
-            x2={left + 18}
-            y1="10"
-            y2="10"
