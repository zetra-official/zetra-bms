{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/src/*": [
        "./src/*"
      ],
      "@/components/*": [
        "./components/*",
        "./src/components/*"
      ],
      "@/hooks/*": [
        "./hooks/*"
      ],
      "@/constants/*": [
        "./constants/*"
      ]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "constants/**/*.ts",
    "hooks/**/*.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "jspdf-browser.d.ts"
  ],
  "exclude": [
    "node_modules",
    "_patch_backups",
    "**/_patch_backups/**",
    "dist",
    "build",
    ".expo",
    "**/*.spec.ts",
    "**/*.test.ts",
    "engineering/**",
    "**/*.backup-*.ts",
    "**/*.backup-*.tsx"
  ]
}
