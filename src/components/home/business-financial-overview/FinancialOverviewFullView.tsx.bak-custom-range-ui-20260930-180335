  const { width, height } =
    useWindowDimensions();

  const workspaceWidth = Math.max(
    760,
    Math.min(
      1320,
      width - 48
    )
  );

  const workspaceHeight = Math.max(
    520,
    Math.min(
      920,
      height - 48
    )
  );

  const chartWidth = Math.max(
    680,
    workspaceWidth - 88
  );

  const chartHeight = Math.max(
    210,
    workspaceHeight - 365
  );

  const netProfitNegative =
    result.total.netProfit < 0;

  return (
    <Modal
      visible={visible}
      transparent
      animationType="fade"
      onRequestClose={onClose}
    >
      <View
        style={{
          flex: 1,
          backgroundColor:
            "rgba(15, 23, 42, 0.58)",
          padding: 24,
          alignItems: "center",
          justifyContent: "center",
        }}
      >
        <View
          style={{
            width: workspaceWidth,
            height: workspaceHeight,
            maxWidth: "100%",
            maxHeight: "100%",
            borderRadius: 22,
            backgroundColor: "#F8FAFC",
            overflow: "hidden",
            borderWidth: 1,
            borderColor: "#CBD5E1",
          }}
        >
          {/* HEADER */}
          <View
            style={{
              minHeight: 66,
              paddingHorizontal: 22,
              paddingVertical: 11,
              backgroundColor: "#FFFFFF",
              borderBottomWidth: 1,
              borderBottomColor: "#E2E8F0",
              flexDirection: "row",
              alignItems: "center",
              justifyContent:
                "space-between",
              gap: 18,
            }}
          >
            <View
              style={{
                flex: 1,
                minWidth: 0,
              }}
            >
              <View
                style={{
                  flexDirection: "row",
                  alignItems: "center",
                  gap: 10,
                }}
              >
                <Text
                  style={{
                    color: "#0F172A",
                    fontSize: 21,
                    fontWeight: "900",
                  }}
                >
                  Business Financial Overview
                </Text>

                <View
                  style={{
                    borderRadius: 999,
                    backgroundColor: "#ECFDF5",
                    paddingHorizontal: 10,
                    paddingVertical: 5,
                  }}
                >
                  <Text
                    style={{
                      color: "#047857",
                      fontSize: 9,
                      fontWeight: "900",
                    }}
                  >
                    VERIFIED FINANCE
                  </Text>
                </View>
              </View>

              <Text
                style={{
                  marginTop: 5,
                  color: "#64748B",
                  fontSize: 11,
                  fontWeight: "700",
                }}
              >
                {rangeLabel}
              </Text>
            </View>

            <View
              style={{
                flexDirection: "row",
                alignItems: "center",
                gap: 10,
              }}
            >
              <View
                style={{
                  borderRadius: 10,
                  backgroundColor: "#F1F5F9",
                  paddingHorizontal: 12,
                  paddingVertical: 8,
                }}
              >
                <Text
                  style={{
                    color: "#334155",
                    fontSize: 10,
                    fontWeight: "900",
                  }}
                >
                  {periodLabel}
                </Text>
              </View>

              <Pressable
                onPress={onClose}
                style={{
                  minWidth: 40,
                  minHeight: 40,
                  borderRadius: 11,
                  backgroundColor: "#0F172A",
                  alignItems: "center",
                  justifyContent: "center",
                  paddingHorizontal: 12,
                }}
              >
                <Text
                  style={{
                    color: "#FFFFFF",
                    fontSize: 17,
                    fontWeight: "900",
                  }}
                >
                  ×
                </Text>
              </Pressable>
            </View>
          </View>

          <View
            style={{
              flex: 1,
              minHeight: 0,
              paddingHorizontal: 20,
              paddingTop: 14,
              paddingBottom: 10,
              overflow: "hidden",
            }}
          >
            {/* PERIOD CONTROLS */}
            <View
              style={{
                flexDirection: "row",
                flexWrap: "wrap",
                alignItems: "center",
                gap: 8,
              }}
            >
              {periodOptions.map(
                (option) => {
                  const selected =
                    option.value ===
                    periodMode;

                  return (
                    <Pressable
                      key={option.value}
                      onPress={() =>
                        onPeriodChange(
                          option.value
