                          }
                          style={{
                            minHeight: 36,
                            flexDirection: "row",
                            alignItems: "center",
                            justifyContent:
                              "center",
                            gap: 7,
                            paddingHorizontal: 12,
                            paddingVertical: 7,
                            borderRadius: 9,
                            borderWidth:
                              selected ? 1 : 0,
                            borderColor:
                              selected
                                ? option.color
                                : "transparent",
                            backgroundColor:
                              selected
                                ? option.activeBackground
                                : "transparent",
                          }}
                        >
                          <View
                            style={{
                              width: 8,
                              height: 8,
                              borderRadius: 999,
                              backgroundColor:
                                option.color,
                            }}
                          />

                          <Text
                            style={{
                              color: selected
                                ? option.color
                                : "#64748B",
                              fontSize: 10,
                              fontWeight: "900",
                            }}
                          >
                            {option.label}
                          </Text>
                        </Pressable>
                      );
                    }
                  )}
                </View>
              </View>

              {/* PERIOD COMPARISON LEGEND */}
              {comparison ? (
                <View
                  style={{
                    marginTop: compactHeight ? 4 : 7,
                    flexDirection: "row",
                    alignItems: "center",
                    justifyContent: "flex-end",
                    gap: 16,
                    paddingRight: 4,
                  }}
                >
                  <View
                    style={{
                      flexDirection: "row",
                      alignItems: "center",
                      gap: 7,
                    }}
                  >
                    <View
                      style={{
                        width: 24,
                        height: 3,
                        borderRadius: 999,
                        backgroundColor: "#2563EB",
                      }}
                    />

                    <Text
                      style={{
                        color: "#334155",
                        fontSize: 9.5,
                        fontWeight: "900",
                      }}
                    >
                      Selected Period
                    </Text>
                  </View>

                  <View
                    style={{
                      flexDirection: "row",
                      alignItems: "center",
                      gap: 7,
                    }}
                  >
                    <View
                      style={{
                        width: 7,
                        height: 3,
                        borderRadius: 999,
                        backgroundColor: "#7C3AED",
                      }}
                    />

                    <View
                      style={{
                        width: 7,
                        height: 3,
                        borderRadius: 999,
                        backgroundColor: "#7C3AED",
                      }}
                    />

                    <View
                      style={{
                        width: 7,
                        height: 3,
                        borderRadius: 999,
                        backgroundColor: "#7C3AED",
                      }}
                    />

                    <Text
                      style={{
                        color: "#6D28D9",
                        fontSize: 9.5,
                        fontWeight: "900",
                      }}
                    >
                      Previous Equivalent Period
                    </Text>
                  </View>
                </View>
              ) : null}

              {loading ? (
                <View
                  style={{
                    minHeight: chartHeight,
                    alignItems: "center",
                    justifyContent:
                      "center",
                  }}
                >
                  <Text
                    style={{
                      color: "#64748B",
                      fontSize: 12,
                      fontWeight: "800",
                    }}
                  >
                    Loading verified finance data...
                  </Text>
                </View>
              ) : errorText ? (
                <View
                  style={{
                    minHeight: chartHeight,
                    alignItems: "center",
                    justifyContent:
                      "center",
                    paddingHorizontal: 20,
                  }}
                >
                  <Text
                    style={{
                      color: "#B91C1C",
                      fontSize: 12,
                      fontWeight: "800",
                      textAlign: "center",
                    }}
                  >
                    {errorText}
                  </Text>
                </View>
              ) : (
                <View
                  style={{
                    marginTop: compactHeight ? 3 : 8,
                    flex: 1,
                    minHeight: 0,
                    width: "100%",
                    overflow: "hidden",
                    alignItems: "center",
                    justifyContent: "center",
                  }}
                >
                  <FinancialChart
                    mode="TREND"
                    metric={
                      selectedMetric
                    }
                    total={result.total}
                    buckets={
                      result.buckets
                    }
                    previousBuckets={
                      comparison?.previous
                        .buckets ?? []
                    }
                    width={chartWidth}
                    height={chartHeight}
                  />
                </View>
              )}
            </View>

            <Text
              style={{
                marginTop: 5,
                color: "#64748B",
                fontSize: 8,
                fontWeight: "700",
                textAlign: "center",
              }}
            >
              ZETRA Business Financial Intelligence
            </Text>
          </View>
        </View>
      </View>
    </Modal>
  );
}








