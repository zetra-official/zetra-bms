                }
                value={result.total.netProfit}
                color={
                  netProfitNegative
                    ? "#DC2626"
                    : "#16A34A"
                }
                subtitle={
                  netProfitNegative
                    ? "Verified loss in selected period"
                    : "Verified net profit in selected period"
                }
              />
            </View>

            {/* MAIN CHART WORKSPACE */}
            <View
              style={{
                marginTop: 11,
                flex: 1,
